# Server-only connection for the separate AVES Australia database.
# Keep real keys in an untracked .env.local or the host's secret settings.
SUPABASE_URL=https://qeyprwftrouztlqmwuzv.supabase.co
SUPABASE_SECRET_KEY=

# Browser-safe settings for the separate Australian Supabase Auth project.
NEXT_PUBLIC_SUPABASE_URL=https://qeyprwftrouztlqmwuzv.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only button allowlist; blank keeps social sign-in hidden.
# Set google,facebook only after provider registration and controlled E2E tests.
# Store provider client secrets in Supabase, never in browser variables or Git.
AVES_OAUTH_PROVIDERS=

# Optional team notification. Requests are saved even when email is unavailable.
# Use a controlled test recipient when verifying notification delivery.
RESEND_API_KEY=
CONTACT_EMAIL=mmelendro@gmail.com
CONTACT_FROM=AVES Australia <noreply@aves.bio>

# Public origin only. The app adds its fixed /australia base path.
NEXT_PUBLIC_SITE_URL=https://aves.bio
